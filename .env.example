# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# In production, set the same names in Vercel: Project Settings -> Environment Variables.
# This file documents variable NAMES only. Do not put real keys in it.

# --- AI summary ---------------------------------------------------------------
# Any OpenAI-compatible chat-completions provider works. Defaults below are Groq's free tier.
# Leave LLM_API_KEY empty and the site uses the built-in template summary instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- NVD (optional) -----------------------------------------------------------
# A free key raises NVD's limit from 5 to 50 requests per 30 seconds.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
